---
import Base from '../layouts/Base.astro'
import Blocks from './Blocks.astro'
import SiteImage from './SiteImage.astro'
import IntroHighlight from './IntroHighlight.astro'
import { certificateAlt, contentImageAlt, faqQrAlt, homePhotoAlt, productPhotoAlt } from '../data/image-alt'
import type { SitePage } from '../data/types'
import { productPath } from '../data/catalog'
import { productTranslation } from '../data/product-translations'
import { getCollection } from 'astro:content'
import { reviewItems, testimonialCopy } from '../data/testimonials'
import { strings } from '../i18n'
import facts from '../data/facts.json'
import { formCopy, privacyCopy, privacyPath, webinarPrivacyNotice } from '../data/privacy'
import { resolveFactTokens } from '../data/resolve-facts'
import { webinarGuideCopy, webinarRegistrationChoices } from '../data/webinar-guide'
import { zhFaq } from '../data/zh-faq'
import { purchaseUrl, shopCopy, storeOrigin } from '../data/commerce'

interface Props { page: SitePage }
const { page } = Astro.props
const lang = page.lang || 'en'
const dictionary = strings[lang]
const ui = dictionary.page
const isChineseLegal = page.lang === 'zh' && ['/zh/commercial-disclosure/', '/zh/returns-and-exchanges/'].includes(page.path)
const isLegalPage = page.path.includes('commercial-disclosure') || page.path.includes('returns-and-exchanges')
const detailLabel = isChineseLegal ? '交易資訊' : isLegalPage ? page.title : page.kind === 'about' || page.kind === 'story' ? ui.story : ui.kind[page.kind as keyof typeof ui.kind] || ui.story
const homeIntroCopy = dictionary.home.introCopy
const heroProduct = dictionary.home.heroProduct
const webinarPath = lang === 'en' ? '/webinar/' : `/${lang}/webinar/`
const slideshowCopy = dictionary.slideshow
const visualSlides = Array.from({ length: 9 }, (_, index) => ({
  url: `/media/2026/10/visual-slide-${String(index + 1).padStart(2, '0')}.webp`,
  number: String(index + 1).padStart(2, '0'),
}))
const sectionLabels = dictionary.home.sectionLabels
const storyPath = { en: '/about/', ja: '/ja/about/', fr: '/fr/about/', th: '/th/about/', zh: '/zh/about/' }[lang]
const isHome = page.kind === 'home'
const homeBlocks = isHome ? page.blocks.filter((block) => block.type !== 'image') : []
const homeHeadings = homeBlocks.filter((block) => block.type === 'h2')
const breakJapaneseOrigin = lang === 'ja' && homeHeadings[1]?.text === 'PROTAIの由来と開発背景'
const firstParagraph = page.blocks.find((block) => block.type === 'p')?.text || ''
const webinarGuide = webinarGuideCopy[lang]
const webinarStepStart = page.kind === 'webinar' && lang !== 'fr' ? page.blocks.findIndex((block) => block.type === 'h2' && /ステップ1|Step 1|ขั้นตอนที่ 1|步驟 1/.test(block.text || '')) : -1
const webinarSteps = webinarStepStart >= 0 ? page.blocks.slice(webinarStepStart)
  .filter((block) => !/✨|ปกป้องการมองเห็น|protecting your vision|大切な目を守り/.test(block.text || ''))
  .reduce((groups, block) => {
    if (block.type === 'h2') groups.push({ title: block.text || '', blocks: [] })
    else groups.at(-1)?.blocks.push(block)
    return groups
  }, [] as { title: string; blocks: typeof page.blocks }[]) : []
if (webinarRegistrationChoices[lang] && webinarSteps[0]) {
  webinarSteps[0].blocks = [{ type: 'registration-options' }]
}
const firstVideo = page.videos[0]
const originVideo = isHome ? page.videos[1] : undefined
const captionLabel = { en: 'English', ja: '日本語', fr: 'Français', th: 'ภาษาไทย', zh: '繁體中文' }[lang]
const captionLang = lang === 'zh' ? 'zh-TW' : lang
const isFaq = page.kind === 'faq'
const isProduct = page.kind === 'product'
const isShop = page.kind === 'shop'
const isContact = page.kind === 'contact'
const isPrivacy = page.kind === 'privacy'
const isWebinar = page.kind === 'webinar'
const aboutLead = page.kind === 'about' && !page.path.includes('founder-message') ? {
  en: 'From Kyoto, IPPONGI brings its values, work and vision together around thoughtful everyday care.',
  ja: '京都から、日々のケアに向き合う一凡木の想い、事業、そしてビジョンをご紹介します。',
  fr: 'Depuis Kyoto, découvrez les valeurs, les activités et la vision d’IPPONGI pour le soin au quotidien.',
  th: 'จากเกียวโต มาทำความรู้จักแนวคิด การดำเนินงาน และวิสัยทัศน์ของ IPPONGI ในการดูแลตนเองทุกวัน',
  zh: '從京都出發，認識一凡木的理念、工作，以及對日常照顧的願景。',
}[lang] : undefined
const isCommerce = page.kind === 'commerce'
const bodyLang = page.path === '/ja/front-page/' ? 'en' : lang
const productOne = productPath(lang, 'single')
const productTwo = productPath(lang, 'refill')
const homeRefillImage = lang === 'zh' ? '/media/2025/10/20ml-3.webp' : '/media/2025/11/Refill-Set.webp'
const preserveLines = page.path.endsWith('/founder-message/')
const isEnglishFounder = page.path === '/founder-message/'
const isJapaneseFounder = page.path === '/ja/founder-message/'
const isThaiFounder = page.path === '/th/founder-message/'
const isFounderNote = preserveLines
const fallback = !preserveLines && page.blocks.map((block) => block.text || '').join('').length < page.text.length * .75
const fallbackLines = page.text.split('\n').map((line) => line.trim()).filter(Boolean)
const sourceBlocks = page.blocks.filter((block) => block.type !== 'image' || !!block.url)
const leadImage = preserveLines ? sourceBlocks.find((block) => block.type === 'image')?.url : undefined
const bodyBlocks = sourceBlocks.filter((block) =>
  !leadImage || block.type !== 'image' || block.url !== leadImage,
)
const certificationIndex = isFounderNote ? bodyBlocks.findIndex((block) => block.type === 'h3' && (block.text || '').includes('PROTAI')) : -1
const narrativeBlocks = certificationIndex >= 0 ? bodyBlocks.slice(0, certificationIndex) : bodyBlocks
const certificationBlocks = certificationIndex >= 0 ? bodyBlocks.slice(certificationIndex + 1) : []
type FaqRun = { text: string; bold: boolean; italic: boolean; href?: string }
type FaqNode =
  | { type: 'p' | 'li'; runs: FaqRun[] }
  | { type: 'image'; url: string; alt: string }
  | { type: 'table'; rows: string[][]; boldCells: boolean[][] }
  | { type: 'qrGrid'; items: { label: FaqRun[]; url: string; alt: string }[] }
const faqEntries = isFaq && lang === 'zh' ? zhFaq.map(([question, answer], index) => ({
  id: `zh-${index + 1}`, question,
  nodes: [{ type: 'p' as const, runs: [{ text: answer, bold: false, italic: false }] }],
})) : isFaq ? (await getCollection('faq'))
  .sort((a, b) => a.data.order - b.data.order)
  .flatMap((item) => {
    const translation = item.data.translations[lang]
    return translation ? [{ id: item.id, question: translation.question, nodes: translation.nodes as FaqNode[] }] : []
  }) : []
const faq = { entries: faqEntries.map((entry, index) => ({ ...entry, number: index + 1 })) }
const faqOpeningGallery = [
  { url: '/media/2025/11/Main-Product.webp' },
  { url: '/media/2025/11/Refill-Set.webp' },
]
const escapeFaq = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
const faqMarkup = (runs: FaqRun[]) => runs.map((run) => {
  let html = escapeFaq(run.text).replace(/\n/g, '<br>')
  if (run.italic) html = `<em>${html}</em>`
  if (run.bold) html = `<strong>${html}</strong>`
  if (run.href) html = `<a href="${escapeFaq(run.href)}" target="_blank" rel="noopener noreferrer">${html}</a>`
  return html
}).join('')
const registrationMatch = page.text.match(/https:\/\/prosunfun\.protai\.com\.tw\/[^\s]+/)
const registration = lang === 'zh' && isWebinar ? { href: 'https://prosunfun.protai.com.tw/f/eyecareseminar', text: ui.register } : page.links.find((link) => /prosunfun|registration|seminar/i.test(link.href)) ||
  (registrationMatch ? { href: registrationMatch[0], text: ui.register } : null)
const price = `¥${page.path.includes('20ml') ? facts.products.refill.priceLabel : facts.products.single.priceLabel}`
const productImage = page.path.includes('20ml') ? '/media/2025/10/20ml-3.webp' : '/media/2025/10/10ml-4.webp'
const productPurchaseUrl = purchaseUrl(lang, page.path.includes('20ml') ? 'refill' : 'single')
const refillStockQuantity = facts.products.refill.stockQuantity
const refillEntryStock = {
  en: `Stock: ${refillStockQuantity} · View details`,
  ja: `在庫：${refillStockQuantity} · 詳細を見る`,
  fr: `Stock : ${refillStockQuantity} · Voir les détails`,
  th: `สินค้าคงเหลือ: ${refillStockQuantity} · ดูรายละเอียด`,
  zh: `庫存：${refillStockQuantity} · 查看介紹`,
}[lang]
const shop = shopCopy[lang]
const productParts = isProduct ? page.text.split('(English Introduction)') : []
const productEnglishLines = (productParts[1] || '').split('\n').map((line) => line.trim()).filter(Boolean)
const productJapaneseAll = (productParts[0] || '').split('\n').map((line) => line.trim()).filter(Boolean)
const productJapaneseLines = productJapaneseAll.slice(Math.max(0, productJapaneseAll.findIndex((line) => line.includes('🌿 PROTAI'))))
const translatedProduct = isProduct ? productTranslation(lang, page.path.includes('20ml') ? 'refill' : 'single') : undefined
const productLead = translatedProduct?.lead || (lang === 'ja' ? productJapaneseLines[2] : productEnglishLines.slice(1, 5).join(' '))
const originalProductLines = lang === 'ja' ? productJapaneseLines.slice(1) : productEnglishLines
const productEnd = originalProductLines.findIndex((line) => lang === 'ja'
  ? line.includes('本製品は医薬品ではなく')
  : line.includes('This product is not a medicine'))
const productPrimaryLines = (productEnd >= 0 ? originalProductLines.slice(0, productEnd + 1) : originalProductLines)
  .flatMap((line) => line.split(/(?=【)/).map((part) => part.trim()).filter(Boolean))
  .filter((line) => !/回数制限なく|No limit on number of uses|The product is safe, but consult/.test(line))
  .map((line) => line.includes('Avoid direct contact with the eyes is considerable')
    ? 'Avoid contact with the eyes. If contact occurs, rinse with water; consult an eye specialist if discomfort persists.'
    : line)
const productSections: { title: string; lines: string[] }[] = translatedProduct?.sections || [{ title: ui.productOverview, lines: [] }]
for (const line of translatedProduct ? [] : productPrimaryLines) {
  const match = line.match(/^【([^】]+)】[:：]?\s*(.*)$/)
  if (match) productSections.push({ title: match[1], lines: match[2] ? [match[2]] : [] })
  else productSections[productSections.length - 1].lines.push(line)
}
const productCardName = ui.productName
const purchaseLinks = dictionary.purchase
const homeTestimonials = testimonialCopy[lang]
const filmTitles = dictionary.home.filmTitles
const testimonialRows = [reviewItems.slice(0, 2), reviewItems.slice(2)]
const contactData = { ...dictionary.contact, faq: lang === 'en' ? '/faq/' : `/${lang}/faq/` }
const contactForm = formCopy[lang]
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY
const privacy = resolveFactTokens(privacyCopy[lang], lang)
---
<Base page={page}>
  {isHome ? <>
    <section class:list={['home-hero', lang !== 'ja' && 'home-hero-translated']} data-hero>
      <div class="hero-copy"><p class="chapter-label" data-reveal>IPPONGI KYOTO</p><h1><span class="hero-title-line hero-title-brand">PROTAI</span>{' '}<span class="hero-title-line hero-title-product">{heroProduct}</span></h1><p class="hero-intro" data-reveal>{dictionary.home.heroAudience}</p><p class="hero-poem" data-reveal>{dictionary.home.heroPoem}</p><div class="hero-actions" data-reveal><a class="primary-link" href={productOne}>{ui.view} <span aria-hidden="true">↗</span></a><a class="quiet-link" href={webinarPath}>{dictionary.home.webinarAction}<span aria-hidden="true">↗</span></a></div></div>
      <div class="hero-visual" id="film"><div class="hero-image-mask"><video class="hero-film" controls preload="none" poster="/responsive/media/2025/07/0-July-960.webp" playsinline aria-label={filmTitles[0] || ui.film}><source src={firstVideo} type="video/mp4" /><track kind="captions" src={`/captions/${lang}-concept.vtt`} srclang={captionLang} label={captionLabel} /></video></div></div>
      <div class="hero-sideword" aria-hidden="true">IPPONGI KYOTO</div>
    </section>
    <section class="intro-section section-wrap" id="discover">
      <div class="intro-section-heading" data-reveal><span class="section-number">01 — {sectionLabels.intro}</span><div class="intro-heading"><span class="fine-line"></span><h2>{homeHeadings[0]?.text}</h2><p>{homeIntroCopy[2]}</p></div></div>
      <div class="intro-highlights">{dictionary.home.highlights.map((item, index) => <IntroHighlight index={index} title={item.title} body={item.body} />)}</div>
    </section>
    <section class="origin-section origin-section-text"><div class="origin-panel" data-reveal><span class="section-number">02 — {sectionLabels.origin}</span><h2>{breakJapaneseOrigin ? <><span class="ja-phrase">PROTAIの</span><span class="ja-phrase">由来と</span><span class="ja-phrase">開発背景</span></> : homeHeadings[1]?.text}</h2>{dictionary.home.originCopy.map((line) => <p>{line}</p>)}{originVideo && <figure class="origin-film"><div class="film-frame"><video controls preload="none" poster="/responsive/media/2025/07/1-July-960.webp" playsinline aria-label={filmTitles[1] || ui.film}><source src={originVideo} type="video/mp4" /><track kind="captions" src={`/captions/${lang}-origin.vtt`} srclang={captionLang} label={captionLabel} /></video></div><figcaption class="film-caption">{filmTitles[1] || ui.film}</figcaption></figure>}</div></section>
    <section class="product-section section-wrap"><div class="section-lead" data-reveal><span class="section-number">03 — {sectionLabels.product}</span><h2>{ui.product}</h2><p>{ui.productText}</p></div><div class="product-grid" data-reveal><a class="product-card" href={productOne}><div class="product-photo"><SiteImage src="/media/2025/10/10ml-4.webp" alt={productPhotoAlt(lang)} sizes="(max-width: 560px) calc(100vw - 40px), 590px" /></div><div class="product-caption"><span>01 / PROTAI</span><h3>{productCardName} · 10ml</h3><p>¥{facts.products.single.priceLabel}</p><span class="card-arrow">↗</span></div></a><a class="product-card" href={productTwo}><div class="product-photo"><SiteImage src={homeRefillImage} alt={productPhotoAlt(lang, true)} sizes="(max-width: 560px) calc(100vw - 40px), 590px" /></div><div class="product-caption"><span>02 / PROTAI</span><h3>{dictionary.home.refillLabel}</h3><p>¥{facts.products.refill.priceLabel}</p><small>{dictionary.home.refillNote}</small><span class="card-arrow">↗</span></div></a></div></section>
    <section class="testimonials-section" id="voices"><div class="testimonials-inner"><div class="testimonials-heading section-wrap" data-reveal><div><span class="section-number">04 — {homeTestimonials.eyebrow.toLocaleUpperCase(lang)}</span><h2>{lang === 'ja' && homeTestimonials.heading === '世界から届いた声' ? <><span class="ja-phrase">世界から</span><span class="ja-phrase">届いた声</span></> : homeTestimonials.heading}</h2><div class="testimonials-countries"><span>JP / {homeTestimonials.country.jp}</span><span>MY / {homeTestimonials.country.my}</span></div></div><p>{homeTestimonials.note}</p></div><div class="testimonial-rails">{testimonialRows.map((row, rowIndex) => <div class="testimonial-rail" data-testimonial-slider data-direction={rowIndex === 0 ? 'forward' : 'backward'} role="region" aria-label={homeTestimonials.rail[rowIndex]} tabindex="0"><div class="splide__track"><ul class="splide__list">{row.map((item) => <li class="splide__slide"><figure class="testimonial-card"><div class="testimonial-card-head"><span class="testimonial-country">{homeTestimonials.country[item.country]}</span></div><div class="testimonial-card-body"><strong>{item.topic[lang]}</strong>{item.kind === 'excerpt' ? <blockquote class="testimonial-text">{item.text[lang]}</blockquote> : <p class="testimonial-text">{item.text[lang]}</p>}</div></figure></li>)}</ul></div></div>)}</div><div class="testimonials-footer section-wrap"><p class="testimonials-hint">{homeTestimonials.hint}</p><button class="testimonials-toggle" type="button" data-testimonial-toggle data-pause-label={homeTestimonials.pause} data-play-label={homeTestimonials.play} aria-pressed="false" hidden>{homeTestimonials.pause}</button></div></div></section>
    <section class="home-slideshow section-wrap" data-home-slideshow data-pause-label={slideshowCopy.pause} data-play-label={slideshowCopy.play}>
      <div class="home-slideshow-heading"><h2>{slideshowCopy.title}</h2><span>PROTAI / IPPONGI KYOTO</span></div>
      <div class="splide home-slideshow-slider" role="region" aria-roledescription="carousel" aria-label={slideshowCopy.title}>
        <div class="splide__track"><ul class="splide__list">{visualSlides.map((slide, index) => <li class="splide__slide"><SiteImage src={slide.url} alt={homePhotoAlt(lang, index + 1)} sizes="(max-width: 780px) calc(100vw - 40px), 1280px" /></li>)}</ul></div>
      </div>
      <div class="home-slideshow-controls">
        <span class="home-slideshow-count" aria-live="off"><span data-slide-current>01</span><span class="home-slideshow-count-divider">/</span>09</span>
        <div class="home-slideshow-buttons">
          <button type="button" class="home-slideshow-arrow" data-slide-previous aria-label={slideshowCopy.previous} hidden>←</button>
          <button type="button" class="home-slideshow-toggle" data-slide-toggle aria-label={slideshowCopy.pause} aria-pressed="false" hidden>Ⅱ</button>
          <button type="button" class="home-slideshow-arrow" data-slide-next aria-label={slideshowCopy.next} hidden>→</button>
        </div>
      </div>
    </section>
    <section class="film-section section-wrap"><div class="film-heading" data-reveal><span class="section-number">05 — {sectionLabels.film}</span></div><div class="film-preview" data-reveal><video class="film-preview-video" data-teaser-video muted playsinline preload="none" poster="/media/2026/10/protai-film-teaser.webp" aria-hidden="true"><source src={firstVideo} type="video/mp4" /></video><div class="film-preview-shade" aria-hidden="true"></div><div class="film-preview-copy"><span>PROTAI / IPPONGI KYOTO</span><h3>{lang === 'ja' && ui.chapter === '目もとから、静かなケアを' ? <><span class="ja-phrase">目もとから、</span><span class="ja-phrase">静かな</span><span class="ja-phrase">ケアを</span></> : ui.chapter}</h3></div></div></section>
    <section class="closing-section section-wrap" data-reveal><span class="section-number">06 — {sectionLabels.closing}</span><blockquote>{dictionary.home.quoteOpen}{dictionary.home.closingQuote}{dictionary.home.quoteClose}</blockquote><a class="text-link" href={storyPath}>{ui.story}<span aria-hidden="true">↗</span></a></section>
  </> : isFaq ? <>
    <section class="page-hero page-hero-plain faq-hero"><span class="section-number" data-reveal>IPPONGI / {ui.questions}</span><h1 data-reveal>{page.title}</h1></section>
    <section class="faq-section section-wrap">
      <div class="faq-opening-gallery">{faqOpeningGallery.map((item, index) => <figure><SiteImage src={item.url} alt={productPhotoAlt(lang, index === 1)} sizes="(max-width: 780px) calc(100vw - 40px), 560px" loading="eager" fetchpriority={index === 0 ? "high" : "auto"} /></figure>)}</div>
      <div class="faq-list">{faq?.entries.map((entry, index) => <details class="faq-item" open={index === 0}><summary><span>{String(entry.number).padStart(2, '0')}</span><h2>{entry.question}</h2><i aria-hidden="true">+</i></summary><div class="faq-answer">{entry.nodes.map((node) => node.type === 'p' ? <p set:html={faqMarkup(node.runs as FaqRun[])} /> : node.type === 'li' ? <p class="faq-bullet" set:html={faqMarkup(node.runs as FaqRun[])} /> : node.type === 'image' ? <figure class="faq-inline-image"><SiteImage src={node.url} alt={certificateAlt(lang, node.url)} sizes="(max-width: 780px) calc(100vw - 70px), 650px" /></figure> : node.type === 'table' ? <div class="faq-table-scroll"><table><tbody>{node.rows.map((row, rowIndex) => <tr>{row.map((cell, cellIndex) => rowIndex === 0 || cellIndex === 0 ? <th scope={rowIndex === 0 ? 'col' : 'row'}>{cell}</th> : <td class:list={{ 'faq-cell-bold': node.boldCells[rowIndex][cellIndex] }}>{cell}</td>)}</tr>)}</tbody></table></div> : node.type === 'qrGrid' ? <div class="faq-qr-grid">{node.items.map((item) => <figure><figcaption set:html={faqMarkup(item.label as FaqRun[])} /><SiteImage src={item.url} alt={faqQrAlt(lang, item.url)} sizes="185px" /></figure>)}</div> : null)}</div></details>)}</div>
    </section>
  </> : isProduct ? <>
    <section class="product-hero section-wrap"><div class="product-hero-media" data-reveal><SiteImage src={page.productGallery?.[0] || productImage} alt={productPhotoAlt(lang, page.path.includes("20ml"))} sizes="(max-width: 780px) calc(100vw - 40px), 580px" loading="eager" fetchpriority="high" /></div><div class="product-hero-copy" data-reveal><span class="section-number">PROTAI / {ui.madeInJapan}</span><h1>{lang === 'ja' ? <><span class="product-title-brand">PROTAI</span><span class="product-title-name">{page.title.replace(/^PROTAI\s*[—–-]\s*/, '')}</span></> : page.title}</h1><p class="product-price">{price}</p><p>{productLead}</p>{!page.path.includes('20ml') && <a class="product-refill-entry" href={productTwo}><SiteImage src="/media/2025/11/Refill-Set.webp" alt={productPhotoAlt(lang, true)} sizes="72px" /><span><strong>{dictionary.home.refillLabel}</strong><small>{refillEntryStock}</small></span><span class="product-refill-entry-arrow" aria-hidden="true">↗</span></a>}{page.path.includes("20ml") && !facts.products.refill.available && <p class="product-stock-note">{shop.unavailable}</p>}<a class="primary-link" href={productPurchaseUrl} target="_blank" rel="noopener noreferrer">{ui.original} ↗</a><small>{ui.archive}</small><div class="purchase-links">{purchaseLinks.map((link) => <a href={link.href} hreflang={link.lang}>{link.label} ↗</a>)}</div></div></section>
    {(page.productGallery?.length || 0) > 1 && <div class="product-gallery section-wrap">{page.productGallery?.slice(1).map((url) => <SiteImage src={url} alt={productPhotoAlt(lang, url.includes("20ml"))} sizes="260px" />)}</div>}
    <section class="detail-section section-wrap"><div class="detail-sidebar"><span class="section-number">01 — {ui.details}</span><h2>{ui.details}</h2></div><div class="detail-body product-detail-groups">{productSections.map((section, index) => <details class="product-detail-item" open={index === 0}><summary><strong>{section.title}</strong><span aria-hidden="true">＋</span></summary><div class="prose-flow">{section.lines.map((line) => <p>{line}</p>)}</div></details>)}</div></section>
  </> : isShop ? <>
    <section class="page-hero page-hero-plain"><span class="section-number">IPPONGI / PROTAI</span><h1>{page.title}</h1><p>{ui.productText}</p></section>
    <section class="product-section section-wrap shop-list"><div class="product-grid">
      <a class="product-card" href={productOne}><div class="product-photo"><SiteImage src="/media/2025/10/10ml-4.webp" alt={productPhotoAlt(lang)} sizes="(max-width: 560px) calc(100vw - 40px), 590px" /></div><div class="product-caption"><h2>PROTAI · {productCardName} 10ml</h2><p>¥{facts.products.single.priceLabel}</p><span class="card-arrow">↗</span></div></a>
      <a class="product-card" href={productTwo}><div class="product-photo"><SiteImage src="/media/2025/10/20ml-3.webp" alt={productPhotoAlt(lang, true)} sizes="(max-width: 560px) calc(100vw - 40px), 590px" /></div><div class="product-caption"><h2>PROTAI · {productCardName} 10ml × 2</h2><p>¥{facts.products.refill.priceLabel}</p>{!facts.products.refill.available && <small>{shop.unavailable}</small>}<span class="card-arrow">↗</span></div></a>
    </div></section>
    <section class="shop-comparison section-wrap" aria-labelledby="shop-comparison-heading"><span class="section-number">PROTAI / 01</span><h2 id="shop-comparison-heading">{shop.title}</h2><div class="table-scroll"><table><thead><tr><th scope="col">{shop.firstColumn}</th>{shop.columns.map((column) => <th scope="col">{column}</th>)}</tr></thead><tbody>{shop.rows.map(([label, single, refill]) => <tr><th scope="row">{label}</th><td>{single}</td><td>{refill}</td></tr>)}</tbody></table></div>{!facts.products.refill.available && <p class="shop-stock-note">{shop.stock}</p>}</section>
  </> : isContact ? <>
    <section class:list={['page-hero', 'page-hero-plain', lang === 'ja' && 'contact-hero-ja']}><span class="section-number">IPPONGI / KYOTO</span><h1>{page.title}</h1><p>{contactData.intro}</p>{contactData.note && <div class="contact-note"><p>{lang === 'ja' ? <><span class="contact-note-line">{contactData.note.split('ので、')[0]}ので、</span><span class="contact-note-line">{contactData.note.split('ので、')[1]}</span></> : contactData.note}</p><a href={contactData.faq}>FAQ ↗</a></div>}</section><section class:list={['contact-section', 'section-wrap', lang === 'fr' && 'contact-section-fr', lang === 'th' && 'contact-section-th']}><div class="contact-invite" data-reveal><h2>{contactData.heading}</h2><a href={`mailto:${facts.organization.email}`}>{facts.organization.email} ↗</a></div><div class="contact-details" data-reveal><div><span>{contactData.office}</span><p>{contactData.address}</p></div><div><span>{contactData.hours}</span><p>{contactData.schedule}</p></div></div></section>
    <section class="contact-form-section section-wrap" aria-labelledby="contact-form-heading"><div><span class="section-number">IPPONGI / CONTACT</span><h2 id="contact-form-heading">{contactForm.title}</h2></div><form class="contact-form" data-contact-form data-invalid={contactForm.invalid} data-error={contactForm.error} data-sending={contactForm.sending} data-success={contactForm.success} data-send={contactForm.send}>
      <label>{contactForm.name}<input type="text" name="name" autocomplete="name" maxlength="120" required /></label>
      <label>{contactForm.email}<input name="email" type="email" autocomplete="email" maxlength="254" required /></label>
      <label>{contactForm.message}<textarea name="message" rows="6" maxlength="5000" required></textarea></label>
      <div class="contact-honeypot" aria-hidden="true"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
      <input type="hidden" name="startedAt" value="" />
      <label class="contact-consent"><input name="consent" type="checkbox" required /><span>{contactForm.consent} <a href={privacyPath(lang)}>{contactForm.privacy} ↗</a></span></label>
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}
      <button type="submit">{contactForm.send}</button><p class="contact-form-status" role="status" aria-live="polite" data-form-status></p>
    </form>{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}</section>
  </> : isPrivacy ? <>
    <section class="page-hero page-hero-plain"><span class="section-number">IPPONGI / KYOTO</span><h1>{privacy.title}</h1><p>{privacy.description}</p></section>
    <section class="privacy-section section-wrap">{privacy.sections.map((section) => <div><h2>{section.title}</h2><p>{section.body}</p>{section.linkUrl && <a href={section.linkUrl} target="_blank" rel="noopener noreferrer">{section.linkLabel} ↗</a>}</div>)}</section>
  </> : <>
    <section class:list={['page-hero', leadImage ? 'page-hero-image' : 'page-hero-plain', isEnglishFounder && 'founder-hero', isJapaneseFounder && 'founder-hero-ja', isThaiFounder && 'founder-hero-th']}><div class="page-hero-copy"><span class="section-number" data-reveal>IPPONGI / {isChineseLegal ? detailLabel : isFounderNote ? ui.founderNote : ui.kind[page.kind as keyof typeof ui.kind] || page.kind}</span><h1 data-reveal>{page.title}</h1>{!isFounderNote && <p data-reveal lang={bodyLang !== lang ? bodyLang : undefined}>{aboutLead || (isWebinar ? webinarGuide.lead : isChineseLegal ? page.description : firstParagraph.slice(0, 300))}</p>}{isWebinar && registration && <><a class="primary-link" href={registration.href} target="_blank" rel="noopener noreferrer">{ui.register} ↗</a><p class="webinar-privacy-note">{webinarPrivacyNotice[lang].text} <a href={privacyPath(lang)}>{webinarPrivacyNotice[lang].policy} ↗</a></p></>}{isCommerce && <a class="primary-link" href={storeOrigin} target="_blank" rel="noopener noreferrer">{ui.original} ↗</a>}</div>{leadImage && <div class="page-hero-media page-hero-portrait"><SiteImage src={leadImage} alt={contentImageAlt(page, { type: "image", url: leadImage }, 0, page.blocks)} sizes="(max-width: 780px) 100vw, 53vw" loading="eager" fetchpriority="high" /></div>}</section>
    {firstVideo && <section class="film-section section-wrap"><div class="film-frame"><video controls preload="none" playsinline aria-label={ui.film}><source src={firstVideo} type="video/mp4" /></video></div></section>}
    <section class:list={['detail-section', 'section-wrap', isEnglishFounder && 'founder-detail']}><div class="detail-sidebar"><span class="section-number">01 — {detailLabel}</span></div><div class="detail-body" lang={bodyLang !== lang ? bodyLang : undefined}>{isWebinar && webinarSteps.length ? <><p class="webinar-guide-lead">{webinarGuide.detail}</p><h2 class="webinar-guide-heading">{webinarGuide.guide}</h2><div class="webinar-guide-steps">{webinarSteps.map((step, index) => <details open={index === 0}><summary><span>{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><span aria-hidden="true">＋</span></summary><Blocks page={page} blocks={step.blocks} /></details>)}</div></> : fallback ? <div class="prose-flow">{fallbackLines.map((line) => <p data-reveal>{line}</p>)}</div> : <><Blocks page={page} blocks={narrativeBlocks} skipFirstHeading={!isChineseLegal} certificationDescriptions={isFounderNote} />{certificationIndex >= 0 && <section class="certification-topic" aria-labelledby="certification-heading"><span class="section-number">PROTAI / {ui.certification}</span><h2 id="certification-heading">PROTAI — {ui.certification}</h2><Blocks page={page} blocks={certificationBlocks} certificationDescriptions /></section>}</>}</div></section>
  </>}
</Base>
