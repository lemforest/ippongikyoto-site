---
import Base from '../layouts/Base.astro'
import Blocks from './Blocks.astro'
import type { SitePage } from '../data/types'
import { productPath } from '../data/catalog'
import { productTranslation } from '../data/product-translations'
import faqContent from '../data/faq.json'
import { reviewItems, testimonialCopy } from '../data/testimonials'
import type { Locale } from '../data/types'
import { strings } from '../i18n'

interface Props { page: SitePage }
const { page } = Astro.props
const lang = page.lang || 'en'
const dictionary = strings[lang]
const ui = dictionary.page
const detailLabel = page.kind === 'about' || page.kind === 'story' ? ui.story : ui.kind[page.kind as keyof typeof ui.kind] || ui.story
const heroLines = page.text.split('\n').filter(Boolean).slice(0, lang === 'en' ? 3 : 2).map((line) => lang === 'fr' ? line.replace('en toi', 'en vous') : line)
const homeIntroCopy = dictionary.home.introCopy
const heroProduct = dictionary.home.heroProduct
const slideshowCopy = dictionary.slideshow
const visualSlides = Array.from({ length: 9 }, (_, index) => ({
  url: `/media/2026/10/visual-slide-${String(index + 1).padStart(2, '0')}.webp`,
  number: String(index + 1).padStart(2, '0'),
}))
const sectionLabels = dictionary.home.sectionLabels
const storyPath = { en: '/about/', ja: '/ja/about/', fr: '/fr/about/', th: '/th/about/' }[lang]
const isHome = page.kind === 'home'
const homeBlocks = isHome ? page.blocks.filter((block) => block.type !== 'image') : []
const homeHeadings = homeBlocks.filter((block) => block.type === 'h2')
const homeIntroLead = homeBlocks.find((block) => block.type === 'h3' || block.type === 'h5')?.text
const breakJapaneseIntro = lang === 'ja' && homeIntroLead === '自然のちからで、目もとと心にやさしいケアを。'
const breakJapaneseOrigin = lang === 'ja' && homeHeadings[1]?.text === 'PROTAIの由来と開発背景'
const homeLines = page.text.split('\n').map((line) => line.trim()).filter(Boolean)
const homeHeadingPositions = isHome ? homeHeadings.slice(0, 3).map((heading) => homeLines.findIndex((line) => line === heading.text)) : []
const homeOriginBody = isHome ? homeLines.slice(homeHeadingPositions[1] + 1, homeHeadingPositions[2]) : []
const homeMolecule = isHome ? page.blocks.find((block) => block.type === 'image' && /Protai-Molecule/.test(block.url || ''))?.url : undefined
const firstParagraph = page.blocks.find((block) => block.type === 'p')?.text || ''
const firstVideo = page.videos[0]
const originVideo = isHome ? page.videos[1] : undefined
const isFaq = page.kind === 'faq'
const isProduct = page.kind === 'product'
const isShop = page.kind === 'shop'
const isContact = page.kind === 'contact'
const isWebinar = page.kind === 'webinar'
const isCommerce = page.kind === 'commerce'
const bodyLang = page.path === '/ja/front-page/' ? 'en' : lang
const productOne = productPath(lang, 'single')
const productTwo = productPath(lang, 'refill')
const preserveLines = page.path.endsWith('/founder-message/')
const isEnglishFounder = page.path === '/founder-message/'
const isJapaneseFounder = page.path === '/ja/founder-message/'
const isFounderNote = preserveLines
const fallback = !preserveLines && page.blocks.map((block) => block.text || '').join('').length < page.text.length * .75
const fallbackLines = page.text.split('\n').map((line) => line.trim()).filter(Boolean)
const sourceBlocks = page.blocks.filter((block) => block.type !== 'image' || !!block.url)
const leadImage = preserveLines ? sourceBlocks.find((block) => block.type === 'image')?.url : undefined
const bodyBlocks = sourceBlocks.filter((block) =>
  (!leadImage || block.type !== 'image' || block.url !== leadImage) &&
  (!isEnglishFounder || block.text?.trim() !== 'Hello everyone,'),
)
const certificationIndex = isEnglishFounder ? bodyBlocks.findIndex((block) => /Safety Certifications and Invention Patents/.test(block.text || '')) : -1
const narrativeBlocks = certificationIndex >= 0 ? bodyBlocks.slice(0, certificationIndex) : bodyBlocks
const certificationBlocks = certificationIndex >= 0 ? bodyBlocks.slice(certificationIndex + 1) : []
type FaqRun = { text: string; bold: boolean; italic: boolean; href?: string }
type FaqNode =
  | { type: 'p' | 'li'; runs: FaqRun[] }
  | { type: 'image'; url: string; alt: string }
  | { type: 'table'; rows: string[][]; boldCells: boolean[][] }
  | { type: 'qrGrid'; items: { label: FaqRun[]; url: string; alt: string }[] }
type FaqPage = { gallery: { url: string; alt: string }[]; entries: { number: number; question: string; nodes: FaqNode[] }[] }
const faq = isFaq ? (faqContent as Record<Locale, FaqPage>)[lang as Locale] : undefined
const faqOpeningGallery = (faqContent as Record<Locale, FaqPage>).fr.gallery
const escapeFaq = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;')
const faqMarkup = (runs: FaqRun[]) => runs.map((run) => {
  let html = escapeFaq(run.text).replace(/\n/g, '<br>')
  if (run.italic) html = `<em>${html}</em>`
  if (run.bold) html = `<strong>${html}</strong>`
  if (run.href) html = `<a href="${escapeFaq(run.href)}" target="_blank" rel="noopener noreferrer">${html}</a>`
  return html
}).join('')
const registrationMatch = page.text.match(/https:\/\/prosunfun\.protai\.com\.tw\/[^\s]+/)
const registration = page.links.find((link) => /prosunfun|registration|seminar/i.test(link.href)) ||
  (registrationMatch ? { href: registrationMatch[0], text: ui.register } : null)
const price = page.path.includes('20ml') ? '¥26,400' : '¥15,400'
const productImage = page.path.includes('20ml') ? '/media/2025/10/20ml-3.webp' : '/media/2025/10/10ml-4.webp'
const productParts = isProduct ? page.text.split('(English Introduction)') : []
const productEnglishLines = (productParts[1] || '').split('\n').map((line) => line.trim()).filter(Boolean)
const productJapaneseAll = (productParts[0] || '').split('\n').map((line) => line.trim()).filter(Boolean)
const productJapaneseLines = productJapaneseAll.slice(Math.max(0, productJapaneseAll.findIndex((line) => line.includes('🌿 PROTAI'))))
const translatedProduct = isProduct ? productTranslation(lang, page.path.includes('20ml') ? 'refill' : 'single') : undefined
const productLead = translatedProduct?.lead || (lang === 'ja' ? productJapaneseLines[2] : productEnglishLines.slice(1, 5).join(' '))
const originalProductLines = lang === 'ja' ? productJapaneseLines.slice(1) : productEnglishLines
const productEnd = originalProductLines.findIndex((line) => lang === 'ja'
  ? line.includes('本製品は医薬品ではなく')
  : line.includes('This product is not a medicine'))
const productPrimaryLines = (productEnd >= 0 ? originalProductLines.slice(0, productEnd + 1) : originalProductLines)
  .flatMap((line) => line.split(/(?=【)/).map((part) => part.trim()).filter(Boolean))
  .filter((line) => !/回数制限なく|No limit on number of uses|The product is safe, but consult/.test(line))
  .map((line) => line.includes('Avoid direct contact with the eyes is considerable')
    ? 'Avoid contact with the eyes. If contact occurs, rinse with water; consult an eye specialist if discomfort persists.'
    : line)
const productSections: { title: string; lines: string[] }[] = translatedProduct?.sections || [{ title: ui.productOverview, lines: [] }]
for (const line of translatedProduct ? [] : productPrimaryLines) {
  const match = line.match(/^【([^】]+)】[:：]?\s*(.*)$/)
  if (match) productSections.push({ title: match[1], lines: match[2] ? [match[2]] : [] })
  else productSections[productSections.length - 1].lines.push(line)
}
const productCardName = ui.productName
const purchaseLinks = dictionary.purchase
const homeTestimonials = testimonialCopy[lang]
const filmTitles = dictionary.home.filmTitles
const testimonialRows = [reviewItems.slice(0, 4), reviewItems.slice(4)]
const contactData = { ...dictionary.contact, faq: lang === 'en' ? '/faq/' : `/${lang}/faq/` }
---
<Base page={page}>
  {isHome ? <>
    <section class:list={['home-hero', lang !== 'ja' && 'home-hero-translated']} data-hero>
      <div class="hero-copy"><p class="chapter-label" data-reveal>PROTAI · {heroProduct}</p><h1>{heroLines.map((line) => <span class="hero-title-line">{line}{' '}</span>)}</h1><p class="hero-intro" data-reveal>{breakJapaneseIntro ? <><span class="ja-phrase">自然のちからで、</span><wbr /><span class="ja-phrase">目もとと心に</span><span class="ja-phrase">やさしいケアを。</span></> : homeIntroLead}</p><div class="hero-actions" data-reveal><a class="primary-link" href={productOne}>{ui.view} <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#discover">{ui.discover}<span aria-hidden="true">↓</span></a></div></div>
      <div class="hero-visual" id="film"><div class="hero-image-mask"><video class="hero-film" controls preload="none" poster="/media/2025/07/0-July.webp" playsinline aria-label={filmTitles[0] || ui.film}><source src={firstVideo} type="video/mp4" /></video></div></div>
      <div class="hero-sideword" aria-hidden="true">IPPONGI KYOTO</div>
    </section>
    <section class="intro-section section-wrap" id="discover"><div class="section-number" data-reveal>01 — {sectionLabels.intro}</div><div class="intro-heading" data-reveal><span class="fine-line"></span><h2>{homeHeadings[0]?.text}</h2><p>{breakJapaneseIntro ? <><span class="ja-phrase">自然のちからで、</span><wbr /><span class="ja-phrase">目もとと心に</span><span class="ja-phrase">やさしいケアを。</span></> : homeIntroLead}</p>{homeMolecule && <img class="intro-molecule" src={homeMolecule} alt="" loading="lazy" />}</div><div class="intro-content" data-reveal>{homeIntroCopy.map((line) => <p>{line}</p>)}</div></section>
    <section class="origin-section origin-section-text"><div class="origin-panel" data-reveal><span class="section-number">02 — {sectionLabels.origin}</span><h2>{breakJapaneseOrigin ? <><span class="ja-phrase">PROTAIの</span><span class="ja-phrase">由来と</span><span class="ja-phrase">開発背景</span></> : homeHeadings[1]?.text}</h2>{homeOriginBody.slice(0, 2).map((line) => <p>{line}</p>)}{originVideo && <figure class="origin-film"><div class="film-frame"><video controls preload="none" poster="/media/2025/07/1-July.webp" playsinline aria-label={filmTitles[1] || ui.film}><source src={originVideo} type="video/mp4" /></video></div><figcaption class="film-caption">{filmTitles[1] || ui.film}</figcaption></figure>}</div></section>
    <section class="product-section section-wrap"><div class="section-lead" data-reveal><span class="section-number">03 — {sectionLabels.product}</span><h2>{ui.product}</h2><p>{ui.productText}</p></div><div class="product-grid" data-reveal><a class="product-card" href={productOne}><div class="product-photo"><img src="/media/2025/10/10ml-4.webp" alt={`PROTAI ${productCardName} 10ml`} loading="lazy" /></div><div class="product-caption"><span>01 / PROTAI</span><h3>{productCardName} · 10ml</h3><p>¥15,400</p><span class="card-arrow">↗</span></div></a><a class="product-card" href={productTwo}><div class="product-photo"><img src="/media/2025/10/20ml-3.webp" alt={`PROTAI ${productCardName} 10ml × 2`} loading="lazy" /></div><div class="product-caption"><span>02 / PROTAI</span><h3>{productCardName} · 10ml × 2</h3><p>¥26,400</p><span class="card-arrow">↗</span></div></a></div></section>
    <section class="testimonials-section" id="voices"><div class="testimonials-inner"><div class="testimonials-heading section-wrap" data-reveal><div><span class="section-number">04 — {homeTestimonials.eyebrow.toLocaleUpperCase(lang)}</span><h2>{lang === 'ja' && homeTestimonials.heading === '世界から届いた声' ? <><span class="ja-phrase">世界から</span><span class="ja-phrase">届いた声</span></> : homeTestimonials.heading}</h2><div class="testimonials-countries"><span>JP / {homeTestimonials.country.jp}</span><span>MY / {homeTestimonials.country.my}</span><span>TW / {homeTestimonials.country.tw}</span></div></div><p>{homeTestimonials.note}</p></div><div class="testimonial-rails">{testimonialRows.map((row, rowIndex) => <div class="splide testimonial-rail" data-testimonial-slider data-direction={rowIndex === 0 ? 'forward' : 'backward'} aria-label={homeTestimonials.rail[rowIndex]}><div class="splide__track"><ul class="splide__list">{row.map((item) => <li class="splide__slide"><figure class="testimonial-card"><div class="testimonial-card-head"><span class="testimonial-country">{homeTestimonials.country[item.country]}</span></div><div class="testimonial-card-body"><strong>{item.topic[lang]}</strong>{item.kind === 'excerpt' ? <blockquote class="testimonial-text">{item.text[lang]}</blockquote> : <p class="testimonial-text">{item.text[lang]}</p>}</div></figure></li>)}</ul></div></div>)}</div><div class="testimonials-footer section-wrap"><p class="testimonials-hint">{homeTestimonials.hint}</p><button class="testimonials-toggle" type="button" data-testimonial-toggle data-pause-label={homeTestimonials.pause} data-play-label={homeTestimonials.play} aria-pressed="false" hidden>{homeTestimonials.pause}</button></div></div></section>
    <section class="home-slideshow section-wrap" aria-label={slideshowCopy.title} data-home-slideshow data-pause-label={slideshowCopy.pause} data-play-label={slideshowCopy.play}>
      <div class="home-slideshow-heading"><h2>{slideshowCopy.title}</h2><span>PROTAI / IPPONGI KYOTO</span></div>
      <div class="splide home-slideshow-slider" aria-label={slideshowCopy.title}>
        <div class="splide__track"><ul class="splide__list">{visualSlides.map((slide, index) => <li class="splide__slide"><img src={slide.url} alt={`${slideshowCopy.photo} ${index + 1}`} loading="lazy" decoding="async" /></li>)}</ul></div>
      </div>
      <div class="home-slideshow-controls">
        <span class="home-slideshow-count" aria-live="off"><span data-slide-current>01</span><span class="home-slideshow-count-divider">/</span>09</span>
        <div class="home-slideshow-buttons">
          <button type="button" class="home-slideshow-arrow" data-slide-previous aria-label={slideshowCopy.previous} hidden>←</button>
          <button type="button" class="home-slideshow-toggle" data-slide-toggle aria-label={slideshowCopy.pause} aria-pressed="false" hidden>Ⅱ</button>
          <button type="button" class="home-slideshow-arrow" data-slide-next aria-label={slideshowCopy.next} hidden>→</button>
        </div>
      </div>
    </section>
    <section class="film-section section-wrap"><div class="film-heading" data-reveal><span class="section-number">05 — {sectionLabels.film}</span></div><div class="film-preview" data-reveal><video class="film-preview-video" data-teaser-video muted playsinline preload="none" poster="/media/2026/10/protai-film-teaser.webp" aria-hidden="true"><source src={firstVideo} type="video/mp4" /></video><div class="film-preview-shade" aria-hidden="true"></div><div class="film-preview-copy"><span>PROTAI / IPPONGI KYOTO</span><h3>{lang === 'ja' && ui.chapter === '目もとから、静かなケアを' ? <><span class="ja-phrase">目もとから、</span><span class="ja-phrase">静かな</span><span class="ja-phrase">ケアを</span></> : ui.chapter}</h3></div></div></section>
    <section class="closing-section section-wrap" data-reveal><span class="section-number">06 — {sectionLabels.closing}</span><blockquote>“{dictionary.home.closingQuote}”</blockquote><a class="text-link" href={storyPath}>{ui.story}<span aria-hidden="true">↗</span></a></section>
  </> : isFaq ? <>
    <section class="page-hero page-hero-plain faq-hero"><span class="section-number" data-reveal>IPPONGI / {ui.questions}</span><h1 data-reveal>{page.title}</h1></section>
    <section class="faq-section section-wrap">
      <div class="faq-opening-gallery">{faqOpeningGallery.map((item) => <figure><img src={item.url} alt={item.alt || ui.productName} loading="eager" /></figure>)}</div>
      <div class="faq-list">{faq?.entries.map((entry, index) => <details class="faq-item" open={index === 0}><summary><span>{String(entry.number).padStart(2, '0')}</span><h2>{entry.question}</h2><i aria-hidden="true">+</i></summary><div class="faq-answer">{entry.nodes.map((node) => node.type === 'p' ? <p set:html={faqMarkup(node.runs as FaqRun[])} /> : node.type === 'li' ? <p class="faq-bullet" set:html={faqMarkup(node.runs as FaqRun[])} /> : node.type === 'image' ? <figure class="faq-inline-image"><img src={node.url} alt={node.alt || ''} loading="lazy" /></figure> : node.type === 'table' ? <div class="faq-table-scroll"><table><tbody>{node.rows.map((row, rowIndex) => <tr>{row.map((cell, cellIndex) => rowIndex === 0 || cellIndex === 0 ? <th scope={rowIndex === 0 ? 'col' : 'row'}>{cell}</th> : <td class:list={{ 'faq-cell-bold': node.boldCells[rowIndex][cellIndex] }}>{cell}</td>)}</tr>)}</tbody></table></div> : node.type === 'qrGrid' ? <div class="faq-qr-grid">{node.items.map((item) => <figure><figcaption set:html={faqMarkup(item.label as FaqRun[])} /><img src={item.url} alt={item.alt || ui.register} loading="eager" /></figure>)}</div> : null)}</div></details>)}</div>
    </section>
  </> : isProduct ? <>
    <section class="product-hero section-wrap"><div class="product-hero-media" data-reveal><img src={page.productGallery?.[0] || productImage} alt={page.title} fetchpriority="high" /></div><div class="product-hero-copy" data-reveal><span class="section-number">PROTAI / {ui.madeInJapan}</span><h1>{lang === 'ja' ? <><span class="product-title-brand">PROTAI</span><span class="product-title-name">{page.title.replace(/^PROTAI\s*[—–-]\s*/, '')}</span></> : page.title}</h1><p class="product-price">{price}</p><p>{productLead}</p><a class="primary-link" href={page.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.original} ↗</a><small>{ui.archive}</small><div class="purchase-links">{purchaseLinks.map((link) => <a href={link.href} hreflang={link.lang}>{link.label} ↗</a>)}</div></div></section>
    {(page.productGallery?.length || 0) > 1 && <div class="product-gallery section-wrap">{page.productGallery?.slice(1).map((url) => <img src={url} alt={page.title} loading="lazy" />)}</div>}
    <section class="detail-section section-wrap"><div class="detail-sidebar"><span class="section-number">01 — {ui.details}</span><h2>{ui.details}</h2></div><div class="detail-body product-detail-groups">{productSections.map((section, index) => <details class="product-detail-item" open={index === 0}><summary><strong>{section.title}</strong><span aria-hidden="true">＋</span></summary><div class="prose-flow">{section.lines.map((line) => <p>{line}</p>)}</div></details>)}</div></section>
  </> : isShop ? <>
    <section class="page-hero page-hero-plain"><span class="section-number">IPPONGI / PROTAI</span><h1>{page.title}</h1><p>{ui.productText}</p></section><section class="product-section section-wrap shop-list"><div class="product-grid"><a class="product-card" href={productOne}><div class="product-photo"><img src="/media/2025/10/10ml-4.webp" alt="PROTAI 10ml" loading="lazy" /></div><div class="product-caption"><h2>PROTAI · {productCardName} 10ml</h2><p>¥15,400</p><span class="card-arrow">↗</span></div></a><a class="product-card" href={productTwo}><div class="product-photo"><img src="/media/2025/10/20ml-3.webp" alt="PROTAI 10ml × 2" loading="lazy" /></div><div class="product-caption"><h2>PROTAI · {productCardName} 10ml × 2</h2><p>¥26,400</p><span class="card-arrow">↗</span></div></a></div></section>
  </> : isContact ? <>
    <section class:list={['page-hero', 'page-hero-plain', lang === 'ja' && 'contact-hero-ja']}><span class="section-number">IPPONGI / KYOTO</span><h1>{page.title}</h1><p>{contactData.intro}</p>{contactData.note && <div class="contact-note"><p>{lang === 'ja' ? <><span class="contact-note-line">{contactData.note.split('ので、')[0]}ので、</span><span class="contact-note-line">{contactData.note.split('ので、')[1]}</span></> : contactData.note}</p><a href={contactData.faq}>FAQ ↗</a></div>}</section><section class:list={['contact-section', 'section-wrap', lang === 'fr' && 'contact-section-fr', lang === 'th' && 'contact-section-th']}><div class="contact-invite" data-reveal><h2>{contactData.heading}</h2><a href="mailto:support@ippongikyoto.com">support@ippongikyoto.com ↗</a></div><div class="contact-details" data-reveal><div><span>{contactData.office}</span><p>{contactData.address}</p></div><div><span>{contactData.hours}</span><p>{contactData.schedule}</p></div></div></section>
  </> : <>
    <section class:list={['page-hero', leadImage ? 'page-hero-image' : 'page-hero-plain', isEnglishFounder && 'founder-hero', isJapaneseFounder && 'founder-hero-ja']}><div class="page-hero-copy"><span class="section-number" data-reveal>IPPONGI / {isFounderNote ? ui.founderNote : ui.kind[page.kind as keyof typeof ui.kind] || page.kind}</span><h1 data-reveal>{isEnglishFounder ? <><span class="founder-heading-line">A Message from</span>{' '}<span class="founder-heading-line">the Representative</span></> : page.title}</h1>{!isFounderNote && <p data-reveal lang={bodyLang !== lang ? bodyLang : undefined}>{firstParagraph.slice(0, 300)}</p>}{isWebinar && registration && <a class="primary-link" href={registration.href} target="_blank" rel="noopener noreferrer">{ui.register} ↗</a>}{isCommerce && <a class="primary-link" href={page.sourceUrl} target="_blank" rel="noopener noreferrer">{ui.original} ↗</a>}</div>{leadImage && <div class="page-hero-media page-hero-portrait"><img src={leadImage} alt={page.title} loading="eager" /></div>}</section>
    {firstVideo && <section class="film-section section-wrap"><div class="film-frame"><video controls preload="none" playsinline aria-label={ui.film}><source src={firstVideo} type="video/mp4" /></video></div></section>}
    <section class:list={['detail-section', 'section-wrap', isEnglishFounder && 'founder-detail']}><div class="detail-sidebar"><span class="section-number">01 — {detailLabel}</span></div><div class="detail-body" lang={bodyLang !== lang ? bodyLang : undefined}>{fallback ? <div class="prose-flow">{fallbackLines.map((line) => <p data-reveal>{line}</p>)}</div> : <><Blocks blocks={narrativeBlocks} skipFirstHeading certificationDescriptions={isFounderNote} />{certificationIndex >= 0 && <section class="certification-topic" aria-labelledby="certification-heading"><span class="section-number">PROTAI / {ui.certification}</span><h2 id="certification-heading">PROTAI — {ui.certification}</h2><Blocks blocks={certificationBlocks} certificationDescriptions /></section>}</>}</div></section>
  </>}
</Base>
