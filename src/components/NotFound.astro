---
import Base from '../layouts/Base.astro'
import type { Locale, SitePage } from '../data/types'

interface Props { lang: Locale }
const { lang } = Astro.props
const copy = {
  en: { title: 'Page not found', body: 'The page you requested could not be found. Choose a language to return to the homepage.', back: 'Back to homepage', nav: 'Homepage by language' },
  ja: { title: 'ページが見つかりません', body: 'お探しのページは見つかりませんでした。言語を選んでホームページへお戻りください。', back: 'ホームへ戻る', nav: '言語別ホームページ' },
  fr: { title: 'Page introuvable', body: 'La page demandée est introuvable. Choisissez une langue pour revenir à l’accueil.', back: 'Retour à l’accueil', nav: 'Accueil par langue' },
  th: { title: 'ไม่พบหน้านี้', body: 'ไม่พบหน้าที่คุณต้องการ กรุณาเลือกภาษาเพื่อกลับสู่หน้าแรก', back: 'กลับสู่หน้าแรก', nav: 'หน้าแรกตามภาษา' },
  zh: { title: '找不到這個頁面', body: '您要找的頁面不存在。請選擇語言，返回對應的首頁。', back: '返回首頁', nav: '選擇語言返回首頁' },
}[lang]
const home = lang === 'en' ? '/' : `/${lang}/`
const homes = [
  { lang: 'en', label: 'English', href: '/' },
  { lang: 'ja', label: '日本語', href: '/ja/' },
  { lang: 'fr', label: 'Français', href: '/fr/' },
  { lang: 'th', label: 'ภาษาไทย', href: '/th/' },
  { lang: 'zh-TW', label: '繁體中文', href: '/zh/' },
]
const page: SitePage = {
  path: `${lang === 'en' ? '' : `/${lang}`}/404/`, lang, kind: 'not-found',
  title: copy.title, description: copy.body, sourceUrl: 'https://ippongikyoto.com/',
  text: '', blocks: [], images: [], videos: [], links: [], alternates: {},
}
---

<Base page={page}>
  <section class="not-found section-wrap" aria-labelledby="not-found-title">
    <div class="not-found-copy">
      <span class="section-number">404</span>
      <h1 id="not-found-title">{copy.title}</h1>
      <p>{copy.body}</p>
      <a class="primary-link" href={home}>{copy.back} <span aria-hidden="true">↗</span></a>
    </div>
    <nav class="not-found-languages" aria-label={copy.nav}>
      {homes.map((item) => <a href={item.href} lang={item.lang}><span>{item.label}</span><span aria-hidden="true">↗</span></a>)}
    </nav>
  </section>
</Base>

<style>
  .not-found { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr); align-items: center; gap: clamp(48px, 8vw, 120px); min-height: min(680px, 72vh); padding-block: clamp(80px, 10vw, 140px); }
  .not-found h1 { max-width: 780px; margin: 22px 0 20px; color: var(--forest); font-family: var(--display); font-size: clamp(54px, 7.2vw, 110px); font-weight: 500; letter-spacing: -.045em; line-height: 1; }
  .not-found p { max-width: 510px; margin: 0 0 34px; color: var(--muted); font-size: clamp(16px, 1.5vw, 19px); }
  .not-found-languages { border-top: 1px solid var(--line); }
  .not-found-languages a { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 66px; padding: 12px 3px; border-bottom: 1px solid var(--line); color: var(--forest); font-size: 18px; }
  .not-found-languages a:hover { color: var(--muted); }
  @media (max-width: 780px) {
    .not-found { grid-template-columns: 1fr; gap: 58px; min-height: 0; }
    .not-found-languages a { min-height: 58px; }
  }
</style>
