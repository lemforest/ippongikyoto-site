---
import { catalogPages } from '../data/catalog'
import Page from '../components/Page.astro'
import type { SitePage } from '../data/types'

export function getStaticPaths() {
  return catalogPages.filter((page) => page.path !== '/').map((page) => ({
    params: { path: page.path.replace(/^\/|\/$/g, '') },
    props: { page },
  }))
}

const page = Astro.props.page as SitePage
---
<Page page={page} />
