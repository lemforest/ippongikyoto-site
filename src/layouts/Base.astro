---
import '../styles/global.css'
import { catalogPages, productPath } from '../data/catalog'
import type { Locale, SitePage } from '../data/types'

interface Props { page: SitePage }
const { page } = Astro.props
const lang: Locale = page.lang || 'en'
const home = { en: '/', ja: '/ja/', fr: '/fr/', th: '/th/' }
const about = { en: '/about/', ja: '/ja/会社案内/', fr: '/fr/qui-sommes-nous/', th: '/th/ข้อมูลบริษัท/' }
const message = { en: '/a-message-from-the-representative-2/', ja: '/ja/a-message-from-the-representative/', fr: '/fr/message-du-representant/', th: '/th/ข้อความจากผู้แทน/' }
const webinar = { en: '/webminar/', ja: '/ja/ウェビナー/', fr: '/webminar/', th: '/th/สัมมนาออนไลน์/' }
const faq = { en: '/faq/', ja: '/ja/faq_jp/', fr: '/fr/faq-fr/', th: '/th/คำถามที่พบบ่อย-faq-th/' }
const contact = { en: '/contact/', ja: '/ja/お問い合わせ/', fr: '/fr/contactez-nous/', th: '/th/ติดต่อเรา/' }
const nav = {
  en: { home: 'Home', message: 'Founder’s note', about: 'Our story', webinar: 'Webinar', product: 'PROTAI', faq: 'FAQ', contact: 'Contact', original: 'Original website', language: 'Language' },
  ja: { home: 'ホーム', message: '代表挨拶', about: '会社案内', webinar: 'ウェビナー', product: 'PROTAI', faq: 'よくある質問', contact: 'お問い合わせ', original: '元のサイト', language: '言語' },
  fr: { home: 'Accueil', message: 'Mot du fondateur', about: 'Notre histoire', webinar: 'Webinaire (EN)', product: 'PROTAI (EN)', faq: 'FAQ', contact: 'Contact', original: 'Site d’origine', language: 'Langue' },
  th: { home: 'หน้าแรก', message: 'ข้อความจากผู้แทน', about: 'ข้อมูลบริษัท', webinar: 'สัมมนาออนไลน์', product: 'PROTAI (EN)', faq: 'คำถามที่พบบ่อย', contact: 'ติดต่อเรา', original: 'เว็บไซต์เดิม', language: 'ภาษา' },
}[lang]
const names = { en: 'EN', ja: 'JP', fr: 'FR', th: 'TH' }
const knownPaths = new Set(catalogPages.map((item) => item.path))
const productHref = productPath(lang)
const localeLinks = (Object.entries(names) as [Locale, string][]).map(([locale, name]) => {
  const alternate = page.alternates?.[locale]
  const hasPage = Boolean(alternate && knownPaths.has(alternate))
  return { locale, name: `${name}${page.kind === 'product' && !hasPage ? ' · Home' : ''}`, href: hasPage ? alternate! : home[locale], hasPage }
})
const cleanTitle = page.title?.replace(/\s*- ippongikyoto\.com$/, '') || 'IPPONGI Kyoto'
const homeDescriptions: Record<Locale, string> = {
  en: 'Discover PROTAI, an eye-area skincare mist from IPPONGI Kyoto. Explore the product, brand story and available formats.',
  ja: 'IPPONGI KYOTOの目もと用スキンケアミスト「PROTAI」。製品情報、ブランドの背景、ラインアップをご覧いただけます。',
  fr: 'Découvrez PROTAI, une brume de soin pour le contour des yeux présentée par IPPONGI Kyoto, ainsi que son histoire et ses formats.',
  th: 'รู้จัก PROTAI ผลิตภัณฑ์สกินแคร์แบบสเปรย์สำหรับบริเวณรอบดวงตาจาก IPPONGI Kyoto พร้อมข้อมูลผลิตภัณฑ์และตัวเลือกสินค้า',
}
const description = page.kind === 'home' ? homeDescriptions[lang] : page.description?.replace(/\s+/g, ' ').trim() || cleanTitle
const ogImage = page.kind === 'home' ? '/media/2025/07/0-July.webp' : page.featureImage || '/media/2025/07/0-July.webp'
const publicSite = import.meta.env.PUBLIC_SITE_URL?.replace(/\/$/, '')
const isPreview = import.meta.env.PUBLIC_PREVIEW === '1' || !publicSite
const isNotFound = page.kind === 'not-found'
const absolute = (path: string) => `${publicSite}${path}`
const canonicalPath = page.kind === 'home' ? home[lang] : page.path
const alternatePages = page.kind === 'home'
  ? Object.entries(home) as [Locale, string][]
  : Object.entries(page.alternates || {}).filter((entry): entry is [Locale, string] => knownPaths.has(entry[1]))
const footer = {
  en: { care: 'From Kyoto, with care.', line: 'Eyes are the windows to the soul.', contact: 'CONTACT', address: '#402 Daini-Kyoto-Bldg., 227 Daikokucho, Shimogyo-ku, Kyoto 600-8223, Japan', top: 'Back to top', home: 'Home', law: 'Legal information (JP)', preview: 'Independent design preview' },
  ja: { care: '京都から、心を込めて。', line: '目は心の窓。', contact: 'お問い合わせ', address: '〒600-8223 京都府京都市下京区大黒町227 第2京都ビル402', top: 'ページ上部へ', home: 'ホーム', law: '特定商取引法に基づく表記', preview: '独立デザインのプレビュー' },
  fr: { care: 'Depuis Kyoto, avec soin.', line: 'Les yeux sont le miroir de l’âme.', contact: 'CONTACT', address: '#402, Daini-Kyoto-Bldg., 227 Daikokucho, Shimogyo-ku, Kyoto 600-8223, Japon', top: 'Retour en haut', home: 'Accueil', law: 'Informations légales (JP)', preview: 'Aperçu du nouveau design' },
  th: { care: 'ด้วยความใส่ใจจากเกียวโต', line: 'ดวงตาเป็นหน้าต่างของหัวใจ', contact: 'ติดต่อ', address: 'ห้อง 402 อาคาร Daini-Kyoto, 227 Daikokucho, เขต Shimogyo, เกียวโต 600-8223 ประเทศญี่ปุ่น', top: 'กลับไปด้านบน', home: 'หน้าแรก', law: 'ข้อมูลทางกฎหมาย (ภาษาญี่ปุ่น)', preview: 'ตัวอย่างการออกแบบเว็บไซต์' },
}[lang]
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <meta name="description" content={description} />
    {(isPreview || isNotFound) && <meta name="robots" content="noindex,nofollow" />}
    {publicSite && !isNotFound && <link rel="canonical" href={absolute(canonicalPath)} />}
    {publicSite && !isNotFound && alternatePages.map(([locale, path]) => <link rel="alternate" hreflang={locale} href={absolute(path)} />)}
    {publicSite && !isNotFound && page.kind === 'home' && <link rel="alternate" hreflang="x-default" href={absolute(home.en)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${cleanTitle} | IPPONGI Kyoto`} />
    <meta property="og:description" content={description} />
    {publicSite && <meta property="og:url" content={absolute(canonicalPath)} />}
    {publicSite && <meta property="og:image" content={absolute(ogImage)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <title>{cleanTitle} | IPPONGI Kyoto</title>
    <link rel="icon" href="/media/2025/05/ippongi-lgo.webp" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=DM+Sans:wght@400;500;600&family=Noto+Sans+JP:wght@400;500&family=Noto+Sans+Thai:wght@400;500&family=Noto+Serif+JP:wght@400;500&family=Noto+Serif+Thai:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="top-rule" aria-hidden="true"></div>
    <header class="site-header" id="top">
      <div class="header-inner">
        <a class="wordmark" href={home[lang]} aria-label={`IPPONGI Kyoto — ${footer.home}`}><span class="wordmark-mark" aria-hidden="true"><img src="/brand/ippongi-logo-96.webp" alt="" width="46" height="54" /></span><span class="wordmark-type"><span>IPPONGI</span><small>KYOTO</small></span></a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          <a class={page.path === home[lang] ? 'active' : ''} href={home[lang]}>{nav.home}</a>
          <a class={page.path === message[lang] ? 'active' : ''} href={message[lang]}>{nav.message}</a>
          <a class={page.path === about[lang] ? 'active' : ''} href={about[lang]}>{nav.about}</a>
          <a class={page.path === webinar[lang] ? 'active' : ''} href={webinar[lang]}>{nav.webinar}</a>
          <a class={page.kind === 'product' ? 'active' : ''} href={productHref}>{nav.product}</a>
          <a class={page.path === faq[lang] ? 'active' : ''} href={faq[lang]}>{nav.faq}</a>
          <a class={page.path === contact[lang] ? 'active' : ''} href={contact[lang]}>{nav.contact}</a>
        </nav>
        <div class="header-actions">
          <details class="locale-switcher"><summary aria-label={nav.language}>{names[lang]} <span class="locale-chevron" aria-hidden="true"></span></summary><div class="locale-list">
            {localeLinks.map(({ locale, name, href }) => <a href={href} lang={locale} aria-current={locale === lang ? 'page' : undefined}>{name}</a>)}
          </div></details>
          <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="mobile-navigation" aria-expanded="false"><span></span><span></span></button>
        </div>
      </div>
      <nav class="mobile-nav" id="mobile-navigation" aria-label="Mobile navigation" hidden>
        <a href={home[lang]}>{nav.home}</a><a href={message[lang]}>{nav.message}</a><a href={about[lang]}>{nav.about}</a><a href={webinar[lang]}>{nav.webinar}</a><a href={productHref}>{nav.product}</a><a href={faq[lang]}>{nav.faq}</a><a href={contact[lang]}>{nav.contact}</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-brand"><span class="footer-kicker">{footer.care}</span><strong>IPPONGI</strong><p>{footer.line}</p></div>
        <div class="footer-contact"><span>{footer.contact}</span><a href="mailto:support@ippongikyoto.com">support@ippongikyoto.com</a><p>{footer.address}</p></div>
        <div class="footer-meta"><a href={page.sourceUrl} target="_blank" rel="noopener noreferrer">{nav.original} ↗</a><a href="/ja/特定商取引法に基づく表記/">{footer.law}</a><a href="#top">{footer.top} ↑</a><small>© IPPONGI Kyoto · {footer.preview}</small></div>
      </div>
    </footer>
    <script>
      import '../scripts/motion'
      if (document.querySelector('#voices')) void import('../scripts/testimonials')
      if (document.querySelector('[data-home-slideshow]')) void import('../scripts/home-slideshow')
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle')
      const mobile = document.querySelector<HTMLElement>('.mobile-nav')
      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true'
        toggle.setAttribute('aria-expanded', String(open))
        if (mobile) mobile.hidden = !open
        document.body.classList.toggle('menu-open', open)
      })
      const teaser = document.querySelector<HTMLVideoElement>('[data-teaser-video]')
      if (teaser && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        teaser.addEventListener('timeupdate', () => {
          if (teaser.currentTime >= 7.5) teaser.currentTime = 0
        })
        const observer = new IntersectionObserver(([entry]) => {
          if (entry?.isIntersecting) teaser.play().catch(() => {})
          else teaser.pause()
        }, { threshold: .2 })
        observer.observe(teaser)
      }
    </script>
  </body>
</html>
