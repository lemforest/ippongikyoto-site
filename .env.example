# Set at build time in Cloudflare Pages after the site is ready to go live.
PUBLIC_SITE_URL=https://ippongikyoto.com
PUBLIC_PREVIEW=0
PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Set as runtime bindings/secrets in Cloudflare Pages, never in a public build.
# CF_ACCOUNT_ID=
# CF_EMAIL_API_TOKEN= (secret; Email Sending permission)
# CF_EMAIL_FROM= (verified sender address)
# CONTACT_TO=support@ippongikyoto.com
# ANALYTICS_ENGINE= (Analytics Engine dataset binding, not a text variable)
